            statusBtn.Position = UDim2.new(1, -125, 0.5, -14)
            statusBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 55)
            statusBtn.BorderSizePixel = 0
            statusBtn.Font = Enum.Font.GothamBold
