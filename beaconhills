        infoLabel.BackgroundTransparency = 1
        infoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        infoLabel.TextStrokeTransparency = 0.3
        infoLabel.Font = Enum.Font.Gotham
        infoLabel.TextSize = 11
        infoLabel.Text = "@" .. player.Name
        infoLabel.Parent = bb

        local healthBg = Instance.new("Frame")
        healthBg.Size = UDim2.new(0, 100, 0, 4)
        healthBg.Position = UDim2.new(0.5, -50, 0, 33)
        healthBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        healthBg.BorderSizePixel = 0
        healthBg.Parent = bb

        local bgCorner = Instance.new("UICorner")
        bgCorner.CornerRadius = UDim.new(1, 0)
        bgCorner.Parent = healthBg

        local healthBar = Instance.new("Frame")
        healthBar.Size = UDim2.new(1, 0, 1, 0)
        healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        healthBar.BorderSizePixel = 0
        healthBar.Parent = healthBg

        local barCorner = Instance.new("UICorner")
        barCorner.CornerRadius = UDim.new(1, 0)
        barCorner.Parent = healthBar

        local function updateHealth()
            if hum and hum.Parent then
                local hpFactor = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                healthBar.Size = UDim2.new(hpFactor, 0, 1, 0)
                
                if hpFactor > 0.5 then
                    healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                elseif hpFactor > 0.25 then
                    healthBar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                else
                    healthBar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                end
            end
        end

        updateHealth()
        local healthConn = hum.HealthChanged:Connect(updateHealth)
        table.insert(espConnections, healthConn)
        AddConnection(healthConn)

        local renderConn
        renderConn = RunService.RenderStepped:Connect(function()
            if not (esp_Enabled and char and char.Parent and root and root.Parent) then
                bb:Destroy()
                if renderConn then renderConn:Disconnect() end
            else
                nameLabel.TextColor3 = GetESPColor(player)
            end
        end)
        table.insert(espConnections, renderConn)
        AddConnection(renderConn)
    end

    if player.Character then setupChar(player.Character) end
    local charConn = player.CharacterAdded:Connect(setupChar)
    table.insert(espConnections, charConn)
    AddConnection(charConn)
end

local function RefreshESP()
    EspFolder:ClearAllChildren()
    for _, conn in pairs(espConnections) do
        if conn then conn:Disconnect() end
    end
    espConnections = {}

    if esp_Enabled then
        for _, p in pairs(Players:GetPlayers()) do
            AddCleanESP(p)
        end
    end
end

