        optBtn.TextColor3 = opt.Color
        optBtn.Font = Enum.Font.GothamBold
        optBtn.TextSize = 11
        optBtn.ZIndex = 11
        optBtn.Parent = dropdown

        local optCorner = Instance.new("UICorner")
