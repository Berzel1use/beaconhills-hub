-- Yakalanma Kontrolü (Anti-Grab)
local function isBeingGrabbed()
    local char = LocalPlayer.Character
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("Weld") or obj:IsA("WeldConstraint") or obj:IsA("Motor6D") then
            local p0, p1 = obj.Part0, obj.Part1
            if p0 and p1 then
                local otherPart = (p0:IsDescendantOf(char) and p1) or (p1:IsDescendantOf(char) and p0)
                if otherPart then
                    local otherModel = otherPart:FindFirstAncestorOfClass("Model")
                    if otherModel and otherModel ~= char then
                        local otherPlayer = Players:GetPlayerFromCharacter(otherModel)
                        if otherPlayer then return true end
                    end
                end
            end
        end
    end
    return false
end

