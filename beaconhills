local function SwitchTab(name)
    for tName, frame in pairs(tabs) do
        frame.Visible = (tName == name)
    end
    for tName, btn in pairs(tabButtons) do
        if tName == name then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 35, 35)}):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(22, 25, 35)}):Play()
        end
    end
    activeTabName = name
end

