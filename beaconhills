local function isWhitelisted(id)
    -- ipairs yerine pairs, sayı/yazı formatı çakışmasına karşı tostring() kullanıyoruz
    for _, whitelistedID in pairs(WhitelistIDs) do
        if tostring(whitelistedID) == tostring(id) then
            return true
        end
    end
    return false
end

