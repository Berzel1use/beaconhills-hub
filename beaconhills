-- Sınırsız Stamina / Enerji Mantığı
local ENERGY_VALUE = 9999

local function forceEnergy()
    if not infiniteEnergy_Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end

    local maxEnergy = char:FindFirstChild("MaxEnergy")
    if not maxEnergy then return end

    local energy = maxEnergy:FindFirstChild("Energy")
    if energy and (energy:IsA("NumberValue") or energy:IsA("IntValue")) then
        if energy.Value < ENERGY_VALUE then
            energy.Value = ENERGY_VALUE
        end
    end
end

AddConnection(RunService.Heartbeat:Connect(forceEnergy))

local function setupCharacterEnergy(char)
    task.wait(0.5)
    if not infiniteEnergy_Enabled then return end
    local maxEnergy = char:WaitForChild("MaxEnergy", 5)
    if not maxEnergy then return end

    local energy = maxEnergy:WaitForChild("Energy", 5)
    if not energy then return end

    AddConnection(energy:GetPropertyChangedSignal("Value"):Connect(function()
        if infiniteEnergy_Enabled and energy.Value < ENERGY_VALUE then
            energy.Value = ENERGY_VALUE
        end
    end))

    energy.Value = ENERGY_VALUE
end

if LocalPlayer.Character then
    setupCharacterEnergy(LocalPlayer.Character)
end
AddConnection(LocalPlayer.CharacterAdded:Connect(setupCharacterEnergy))

