        if ripCooldown then return end

        if (obj:IsA("Sound") and obj.Name == "Hit2") or (obj:IsA("ParticleEmitter") and obj.Name == "HitSmoke") then
            ripCooldown = true
            pcall(function()
                if PunchEvent then PunchEvent:FireServer() end
            end)
            task.delay(RIP_COOLDOWN_TIME, function() ripCooldown = false end)
        end
    end))
end

