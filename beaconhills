    dropPadding.PaddingLeft = UDim.new(0, 4)
    dropPadding.PaddingRight = UDim.new(0, 4)
    dropPadding.PaddingBottom = UDim.new(0, 4)
    dropPadding.Parent = dropdown

    local options = {
        {Name = "Enemy", Color = Color3.fromRGB(255, 60, 60)},
        {Name = "Friend", Color = Color3.fromRGB(60, 160, 255)},
        {Name = "None", Color = Color3.fromRGB(180, 180, 180)}
